# ==============================================================================
# Smart Agriculture DSS - Environment Variables Template
# File nay duoc commit len Git lam tai lieu huong dan.
# Copy file nay thanh ".env" va dien gia tri that, KHONG commit file ".env".
# ==============================================================================

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_agriculture_dss
DB_USER=postgres
DB_PASSWORD=

# ---- API ----
API_SECRET_KEY=
API_HOST=0.0.0.0
API_PORT=8000

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- DVC Remote Storage (dien sau o Phase 3 / Phase 11) ----
DVC_REMOTE_URL=

# ---- Environment ----
ENVIRONMENT=development
