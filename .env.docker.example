# ==============================================================================
# Smart Agriculture DSS - Docker Compose Environment Variables Template
# Phase 11 - MLOps & Deployment
# ==============================================================================
# Khác với .env.example (Phase 2, dùng khi chạy API/Dashboard trực tiếp bằng
# venv trên Windows): file này dùng riêng cho `docker-compose up`.
#
# Copy file này thành ".env.docker" (cùng cấp docker-compose.yml) và điền giá
# trị thật. KHÔNG commit ".env.docker" - đã thêm vào .gitignore (pattern có
# sẵn từ Phase 2: "*.env.docker").
#
# Lưu ý: DB_HOST KHÔNG cần khai báo ở đây - docker-compose.yml đã tự đặt
# cứng DB_HOST=postgres (tên service trong mạng Docker nội bộ) cho service
# "api", không đọc từ file .env.docker.
# ==============================================================================

# ---- Database (PostgreSQL container) ----
DB_PORT=5432
DB_NAME=smart_agriculture_dss
DB_USER=postgres
DB_PASSWORD=

# ---- API ----
API_SECRET_KEY=
